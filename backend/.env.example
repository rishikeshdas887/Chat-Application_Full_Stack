# =============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and export variables before running the application
# =============================================================================

# Server Port
SERVER_PORT=8081

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chat_application
SPRING_DATASOURCE_USERNAME=chat_app_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# TOTP Issuer Name
APP_AUTH_TOTP_ISSUER=SyncPulse
